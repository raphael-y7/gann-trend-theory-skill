{
  "skill": "entry-exit-timing-skill",
  "version": "1.0.0",
  "test_cases": [
    {
      "id": "should_trigger-01",
      "type": "should_trigger",
      "prompt": "现在这个位置能买吗，还是再等个回调",
      "expected_behavior": "给位置判定 + 回调买进口径 + 启动即入场规则",
      "notes": "正面：择时主场景"
    },
    {
      "id": "should_trigger-02",
      "type": "should_trigger",
      "prompt": "大赚了一波，要不要先离场观望",
      "expected_behavior": "按作壁上观纪律回答",
      "notes": "正面：离场观望"
    },
    {
      "id": "should_trigger-03",
      "type": "should_trigger",
      "prompt": "目标价设多少合适",
      "expected_behavior": "拒绝预设目标价，改以逆转信号与止损管理离场",
      "notes": "正面：目标价迷思"
    },
    {
      "id": "should_trigger-04",
      "type": "should_trigger",
      "prompt": "急跌两天了，第三天能不能抄底",
      "expected_behavior": "按极端回调两日规则回答，并给失效边界",
      "notes": "正面：急跌抄底"
    },
    {
      "id": "should_not_trigger-01",
      "type": "should_not_trigger",
      "prompt": "这波到底是吸筹还是派发",
      "expected_behavior": "应由 accumulation-distribution-skill 处理",
      "notes": "跨 skill 混淆：区间性质归属"
    },
    {
      "id": "should_not_trigger-02",
      "type": "should_not_trigger",
      "prompt": "这几只候选哪只最强",
      "expected_behavior": "应由 strength-based-selection-skill 处理",
      "notes": "跨 skill 混淆：选股归属"
    },
    {
      "id": "edge_case-01",
      "type": "edge_case",
      "prompt": "我拿不准要不要卖",
      "expected_behavior": "默认结论为退出，并声明原书未量化'合理时间'参数",
      "notes": "边界：拿不准 + 已知缺口"
    }
  ]
}